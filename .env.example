# Private key of the wallet that will mint NFTs.
# DO NOT commit your real .env file. Keep this private.
PRIVATE_KEY=0xyourprivatekeyhere

# Optional: default custom RPC URLs (override the bot's default public RPCs).
# Leave empty to use the public RPCs bundled with the bot.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=

# Optional: OpenSea API key. Used to resolve collection slugs in OpenSea URLs
# (e.g. https://opensea.io/collection/<slug>) into a contract address.
# Get one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
