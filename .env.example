# Private key of the wallet that will mint NFTs.
# DO NOT commit your real .env file. Keep this private.
PRIVATE_KEY=0xyourprivatekeyhere

# Optional: default custom RPC URLs (override the bot's default public RPCs).
# Leave empty to use the public RPCs bundled with the bot.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
ROBINHOOD_RPC_URL=

# Recommended: OpenSea API key. Required to:
#   - resolve /collection/<slug> URLs into a contract address,
#   - fetch drop stages (Public / Allowlist / GTD / Presale) with prices
#     and per-wallet caps,
#   - check wallet eligibility and build the mint transaction for the
#     correct stage automatically.
# Without it, the bot falls back to a generic on-chain mint flow that
# probes common mint signatures and price getters directly.
# Get one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
